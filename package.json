{
  "name": "electron-file-editor",
  "version": "0.1.0",
  "private": true,
  "description": "VSCode-style file browser & editor in Electron — single-platform (macOS) MVP scaffold. Design: docs/electron-file-editor-design.md",
  "main": "out/main/index.js",
  "author": "sounds-great-ai <rouroumaibing@qq.com>",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "node scripts/dev-daemon.mjs start",
    "stop": "node scripts/dev-daemon.mjs stop",
    "status": "node scripts/dev-daemon.mjs status",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "node scripts/dist.mjs",
    "dist:mac": "node scripts/dist.mjs --platform mac",
    "dist:mac:x64": "node scripts/dist.mjs --platform mac --arch x64",
    "dist:mac:arm64": "node scripts/dist.mjs --platform mac --arch arm64",
    "dist:win": "node scripts/dist.mjs --platform win",
    "dist:win:x64": "node scripts/dist.mjs --platform win --arch x64",
    "dist:win:arm64": "node scripts/dist.mjs --platform win --arch arm64",
    "dist:linux": "node scripts/dist.mjs --platform linux",
    "dist:linux:x64": "node scripts/dist.mjs --platform linux --arch x64",
    "dist:linux:arm64": "node scripts/dist.mjs --platform linux --arch arm64",
    "dist:all": "node scripts/dist.mjs --platform all",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "tsc --noEmit && eslint .",
    "e2e": "node scripts/e2e/run.mjs",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "chokidar": "^4.0.3",
    "iconv-lite": "^0.7.3",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6"
  }
}
